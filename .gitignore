.env
node_modules/

# Local wrangler state: the esbuild cache and the miniflare KV/D1/DO stores that
# `wrangler dev --local` writes. Machine-local scratch, several MB of it, and
# the local D1 copy would carry whatever rows a dev session happened to create.
.wrangler/

# Generated SEO landing pages — build artifacts produced from
# public/data/checklists by scripts/build-landing-pages.js (npm run build:pages).
# Regenerated in CI before every deploy; no need to track ~tens of MB of HTML.
public/sets/
public/players/
public/teams/
public/sitemap.xml

# Python bytecode
__pycache__/
*.pyc

# Runtime state the server writes as people search — not source. It was
# committed once by accident carrying test-stub prices.
data/price-history.json

# Runtime user state. These are written by the running server and would leak
# real accounts, sessions and private messages into the repo if committed —
# data/price-history.json below was already caught doing exactly that.
data/users.json
data/sessions.json
data/community.json
data/dms.json
data/feedback.json
data/userdata/
data/userphotos/
